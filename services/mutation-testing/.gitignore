# Trained model weights: a build artifact, rebuilt from the versioned corpus by
# `python src/ml/train.py`. Its provenance record, src/ml/model_meta.json, IS
# committed -- that is what makes a reported result traceable.
src/ml/model.json

# Collected dataset. Regenerated by scripts/collect_dataset.py from the corpus,
# which is the actual source of truth. Committing it caused dataset v1 to be
# silently mixed with test-run pollution.
storage/*.db
storage/archive/

# Per-run audit reports and evaluation output
reports/*.json
reports/*.jsonl
reports/*.log

# mutmut working state (written next to the source it mutates)
mutants/
.mutmut-cache
setup.cfg.bak

# coverage
.coverage
.coverage.*
.coveragerc
htmlcov/

__pycache__/
*.py[cod]
.pytest_cache/
